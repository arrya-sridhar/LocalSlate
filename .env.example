# MySQL Connection Environment Variables
# NOTE: For local dev/test, DB_HOST defaults to 127.0.0.1.
# On Render live deployment, DO NOT set DB_HOST to 127.0.0.1.
# Configure DB_HOST with your Render MySQL database internal host.
# If DB_HOST is missing or set to 127.0.0.1 on Render, MySQL connection will be skipped and the app runs in disconnected fallback mode.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=localslate
DB_USER=root
DB_PASSWORD=root
